#!/bin/sh
set -eu
if [ "$1" = purge ]; then
  rm -f /etc/rele/service.json /etc/systemd/system/rele.service.d/rele-user.conf /var/lib/rele/restart.json
  rmdir /etc/rele /etc/systemd/system/rele.service.d /var/lib/rele 2>/dev/null || true
fi
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi
